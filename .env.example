# =============================================================================
# Dusklight - environment settings for Docker
# Copy to .env and edit:  cp .env.example .env
# Never commit .env. Secrets (tokens, keys) belong here, not in the repository.
# Every variable is documented in config.js. Anything commented out is optional.
#
# Note: AJ_BIND, AJ_DATA_DIR and the container-side ports are already set in the
# Dockerfile (0.0.0.0, /data, 8080, 9339). Don't set them here unless you know
# you need to; use the HOST port variables below instead.
# =============================================================================


# -----------------------------------------------------------------------------
# Host ports (used by docker-compose.yml for the left side of the mapping)
# -----------------------------------------------------------------------------
# AJ_HTTP_PORT=8080          # website, sign-up, admin, dashboard
# AJ_GAME_PORT=9339          # game server


# -----------------------------------------------------------------------------
# LOCAL USE (default): nothing else is required.
# The server stays private and the admin panel works from this machine.
# -----------------------------------------------------------------------------

# Local only: create an account the first time an unknown name logs in from the
# game client. The server REFUSES this if it is public (AJ_PUBLIC_URL set).
# AJ_REGISTER=1

# Local experiments only: accept clients that don't send device IDs
# AJ_REQUIRE_DEVICE=0

# Serve only from the local cache; never fetch game files from the internet
# AJ_OFFLINE=1

# Less logging (packet logging is on by default locally, off when public)
# AJ_QUIET=1


# -----------------------------------------------------------------------------
# PUBLIC SERVER: setting AJ_PUBLIC_URL makes the server "public" (stricter
# defaults; admin panel only answers on the server's own machine).
# Also change docker-compose.yml ports from "127.0.0.1:..." to "8080:8080" and
# "9339:9339". Keep invite-only sign-up on (admin panel > Invites).
# -----------------------------------------------------------------------------
# The address players reach the server at (no trailing slash)
# AJ_PUBLIC_URL=https://play.example.com

# Separate name for the website, if different from the game server's
# AJ_SITE_URL=https://example.com

# Set to 1 when a reverse proxy (nginx, Caddy, Traefik) on the same machine
# fronts the web port
# AJ_TRUSTED_PROXY=1


# -----------------------------------------------------------------------------
# TLS: mount your certificate and key into the container (see the commented
# volume in docker-compose.yml) and point to them. Both ports then use TLS.
# -----------------------------------------------------------------------------
# AJ_TLS_CERT=/certs/fullchain.pem
# AJ_TLS_KEY=/certs/privkey.pem


# -----------------------------------------------------------------------------
# Terms and Privacy pages
# -----------------------------------------------------------------------------
# AJ_OPERATOR=Your Name or Organisation
# AJ_HOSTED_IN=Country
# AJ_LEGAL_EMAIL=legal@example.com       # also the contact for removal requests
# AJ_ADMIN_EMAIL=admin@example.com


# -----------------------------------------------------------------------------
# Cloudflare Turnstile captcha on sign-up
# -----------------------------------------------------------------------------
# AJ_TURNSTILE_SITE_KEY=
# AJ_TURNSTILE_SECRET=


# -----------------------------------------------------------------------------
# Discord staff bot (see deploy/DISCORD.md in the repo)
# -----------------------------------------------------------------------------
# AJ_DISCORD_BOT_TOKEN=
# AJ_DISCORD_GUILD_ID=
